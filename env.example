# Copy to .env for local development, or set these in your host's dashboard.
# Never commit the real key.

# Required. Free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional. Any Gemini model your key can access.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Comma-separated origins allowed to call /api/*. Defaults to "*".
# ALLOWED_ORIGINS=https://lifeops-agent.onrender.com
